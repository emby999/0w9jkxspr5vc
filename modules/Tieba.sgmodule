#!name=百度贴吧签到
#!desc=抓CK + 每日签到 (脚本 tb.js 在你自己仓库里)。打开贴吧自动存 CK, 每天 8:05 自动签到并推送结果。
#!author=emby999

[Script]
百度贴吧抓CK = type=http-request,pattern=^https:\/\/tieba\.baidu\.com\/,script-path=https://raw.githubusercontent.com/emby999/0w9jkxspr5vc/main/tb.js
百度贴吧签到 = type=cron,cronexp="5 8 * * *",timeout=300,script-path=https://raw.githubusercontent.com/emby999/0w9jkxspr5vc/main/tb.js

[MITM]
hostname = %APPEND% tieba.baidu.com
